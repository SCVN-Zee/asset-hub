{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Asset Hub",
  "version": "../../package.json",
  "identifier": "vn.supercent.assethub",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../dist",
    "beforeDevCommand": "bun run vite",
    "beforeBuildCommand": "bun run prebuild:cli && bun run vite build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: assethub-thumb:; connect-src ipc: http://ipc.localhost 'self' blob: data:; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app"],
    "externalBin": ["binaries/asset-hub-cli"],
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": { "minimumSystemVersion": "14.0", "signingIdentity": "-" }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["assethub"] } },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IFBMQUNFSE9MREVSIC0gbm9ib2R5IGhvbGRzIHRoZSBwcml2YXRlIGtleTsgcmVwbGFjZSB3aXRoIHRoZSBwdWJsaWMga2V5IG9mIHRoZSByZWFsIHVwZGF0ZXIga2V5ClJXUnJKMndUNXNpcFBKRmZTczJ6MnRRMklKNW9JK3ZQd29NMUw2c1ZoS0RJQ3cwT1ppZHRVbnpnCg==",
      "requireSignedVersion": true
    }
  }
}
