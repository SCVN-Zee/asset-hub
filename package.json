{
  "name": "asset-hub",
  "version": "2.0.0",
  "private": true,
  "description": "Browse the Unity projects on GitHub, preview their assets and export them as .unitypackage.",
  "scripts": {
    "dev": "ASSETHUB_USER_DATA=\"${ASSETHUB_USER_DATA:-$HOME/Library/Application Support/vn.supercent.assethub-dev}\" tauri dev",
    "prebuild:cli": "sh scripts/cli-sidecar.sh",
    "tauri": "tauri",
    "build": "tauri build",
    "bindings": "ASSETHUB_EXPORT_ONLY=1 cargo run -p asset-hub",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "tauri build --bundles app,dmg",
    "dist:web": "tauri build && bun scripts/make-web-installer.mjs",
    "release": "bun scripts/publish-release.mjs",
    "usage": "bun scripts/usage-report.mjs"
  },
  "devDependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "i18next": "^23.16.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.4",
    "three": "^0.170.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "releaseRepo": "SCVN-Zee/asset-hub",
  "feedbackRepo": "supercent-io/asset-hub-feedback"
}
